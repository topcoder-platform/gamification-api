NODE_ENV=development

# PORT
PORT = 3003

# DATABASE
POSTGRE_SQL_USER=<postgres>
POSTGRE_SQL_PASS=<postgres>
POSTGRE_SQL_DATABASE=<127.0.0.1:5432/tc_gamification>

# TOKEN
SECRET_KEY = secretKey

# LOG
LOG_FORMAT = dev
LOG_DIR = ../logs

# CORS
ORIGIN = *
CREDENTIALS = true

AWS_ACCESS_KEY_ID=<ADD KEY>
AWS_SECRET_ACCESS_KEY=<ADD SECRET>