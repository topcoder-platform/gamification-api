NODE_ENV=development
CDN_S3_BUCKET_NAME=tc-gamification

# PORT
PORT = 3003

# DATABASE
POSTGRE_SQL_USER=<postgres>
POSTGRE_SQL_PASS=<postgres>
POSTGRE_SQL_DATABASE=<127.0.0.1:5432/tc_gamification>

# TOKEN
SECRET_KEY = secretKey

# LOG
LOG_FORMAT = dev
LOG_DIR = ../logs

# CORS
ORIGIN = *
CREDENTIALS = true

# Needed only locally, AWS env has those preconf on EC2
AWS_ACCESS_KEY_ID=<ADD KEY>
AWS_SECRET_ACCESS_KEY=<ADD SECRET>